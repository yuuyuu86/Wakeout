<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(WAKEOUT_BUNDLE_ID).shared</string>
	</array>
	<!-- スクリーンタイムでアプリを制限する機能を使うには、ここに
	     com.apple.developer.family-controls を足し、Xcode の
	     Signing & Capabilities で Family Controls を追加する。

	     ただし**有料の Apple Developer Program が必要**。
	     無料アカウント（Personal Team）にはこの権限が下りず、
	     宣言すると実機にインストールできなくなるため、既定では外してある。

	     <key>com.apple.developer.family-controls</key>
	     <true/>
	-->
</dict>
</plist>
